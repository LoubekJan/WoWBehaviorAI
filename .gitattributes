# Auto detect text files and perform LF normalization
* text=auto


# Whitespace rules
# strict (no trailing, no tabs)
*.cpp    whitespace=trailing-space,space-before-tab,tab-in-indent,cr-at-eol
*.h      whitespace=trailing-space,space-before-tab,tab-in-indent,cr-at-eol

# normal (no trailing)
*.sql    whitespace=trailing-space,space-before-tab,cr-at-eol
*.txt    whitespace=trailing-space,space-before-tab,cr-at-eol

# special files which must ignore whitespace
*.patch  whitespace=-trailing-space eol=lf

# shell scripts run inside Linux containers — never checked out as CRLF
*.sh     text eol=lf
*.diff   whitespace=-trailing-space eol=lf

# Hash-bound NPC deployment records must retain identical bytes on Windows/Linux.
data/realm_lab/aiworldlab/preview-v8/settlement-*.json text eol=lf
data/realm_lab/aiworldlab/preview-v8/wildlife-population.json text eol=lf
data/realm_lab/aiworldlab/preview-v8/supply-population.json text eol=lf
data/realm_lab/aiworldlab/preview-v8/consumer-population.json text eol=lf
data/realm_lab/aiworldlab/preview-v8/raid-population.json text eol=lf
data/realm_lab/aiworldlab/preview-v8/consumer-first-chain-acceptance.json text eol=lf
# Preserve verbatim source audits and the exact bytes pinned by field receipts.
data/realm_lab/aiworldlab/preview-v8/field-*.json -text

# Standard to msysgit
*.doc    diff=astextplain
*.DOC    diff=astextplain
*.docx   diff=astextplain
*.DOCX   diff=astextplain
*.dot    diff=astextplain
*.DOT    diff=astextplain
*.pdf    diff=astextplain
*.PDF    diff=astextplain
*.rtf    diff=astextplain
*.RTF    diff=astextplain

# Ignore sql/* files
sql/*    linguist-documentation

# Complete authored-world stack. Copy to .env, keep it private and replace
# every change-me value before initializing databases. Existing deployments
# migrate their accounts; they do not create replacement accounts.
AUTH_MYSQL_ROOT_PASSWORD=change-me-auth-root
TC_AUTH_SERVER_USER=world_auth_owner
TC_AUTH_SERVER_PASSWORD=change-me-auth-owner
TC_AUTH_DB_HOST=aiworld-auth-db
TC_AUTH_DB_PORT=3306
TC_AUTH_DB_USER=lab_auth
TC_AUTH_DB_PASSWORD=change-me-world-login

# Separate world/characters database; retained lab volume and user identity.
MYSQL_ROOT_PASSWORD=change-me-lab-root
TC_DB_USER=lab_world
TC_DB_PASSWORD=change-me-lab-world

# Retain realm 2 and the deployed client ports when upgrading an existing lab.
LAB_REALM_ID=2
LAB_REALM_NAME=AI World Lab
LAB_REALM_ADDRESS=192.168.0.248
LAB_REALM_LOCAL_ADDRESS=192.168.0.248
LAB_REALM_LOCAL_SUBNET_MASK=255.255.255.0
AUTHSERVER_PORT=3724
LAB_WORLD_PORT=9086
LAB_VIEWER_PORT=9091
ACCOUNT_WEB_PORT=9088
WORLD_VIEWER_TELEMETRY_TOKEN=change-me-world-telemetry

# Authored map 725 / area 4988: 100 native NPCs and live observer telemetry.
# AI management, hunger, groups and model requests remain disabled.
# Historical return/hunt profiles are manual regression tools only.
LAB_AI_PROFILE=settlement-v8
# wildlife-v8 opts in 20 animals; 0 pauses its runtime AI, retaining identities/memory.
LAB_WILDLIFE_ENABLED=1
# Only authored NPC profiles opt in; requires consumers-v8 or raids-v8.
LAB_NPC_AGENTS_ENABLED=0
LAB_NPC_AGENTS_DECISION_INTERVAL_MS=8000
LAB_NPC_AGENTS_MAX_IN_FLIGHT=2
LAB_NPC_AGENTS_TIMEOUT_MS=15000

# SOAP remains internal to Docker. Account registration needs an existing
# TrinityCore administrator for realm 2 (or global -1); see README_DEV.md.
LAB_SOAP_ENABLED=1
TC_SOAP_USER=
TC_SOAP_PASSWORD=
TC_ACCOUNT_EXPANSION=2

DEV_UID=1000
DEV_GID=1000

# Optional inference backend; current settlement requests remain disabled.
AI_TASK_MODEL_URL=
AI_TASK_MODEL_NAME=
AI_TASK_MODEL_API_KEY=
AI_TASK_MODEL_ENABLE_THINKING=0
# Independent NPC decisions; empty provider settings reuse AI_TASK_MODEL_*.
AI_NPC_MODEL_ENABLED=0
AI_NPC_MODEL_URL=
AI_NPC_MODEL_NAME=
AI_NPC_MODEL_API_KEY=
AI_NPC_MODEL_TIMEOUT_MS=10000
AIWORLD_RECORD_HOURS=4
AIWORLD_RECORD_INTERVAL=5
AIWORLD_TEST_MINUTES=60
AIWORLD_RECORD_BUILD_LABEL=unknown

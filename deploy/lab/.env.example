# Copy to deploy/lab/.env IN THE SEPARATE LAB CHECKOUT. Never use Elwynn's .env.
# Change every change-me value before setup or deployment.
MYSQL_ROOT_PASSWORD=change-me-lab-root
TC_DB_USER=lab_world
TC_DB_PASSWORD=change-me-lab-world

# Shared auth server stays in the original stack. The lab user receives DML
# on auth only; it never receives privileges on the original world/characters.
SHARED_AUTH_NETWORK=aitc-shared-auth
TC_AUTH_DB_HOST=aiworld-auth-db
TC_AUTH_DB_PORT=3306
TC_AUTH_DB_USER=lab_auth
TC_AUTH_DB_PASSWORD=change-me-lab-auth

LAB_REALM_ID=2
LAB_REALM_NAME=AI World Lab
LAB_REALM_ADDRESS=192.168.0.248
LAB_REALM_LOCAL_ADDRESS=192.168.0.248
LAB_REALM_LOCAL_SUBNET_MASK=255.255.255.0
LAB_WORLD_PORT=9086
LAB_VIEWER_PORT=9091
WORLD_VIEWER_TELEMETRY_TOKEN=change-me-lab-telemetry
# disabled is phase 0: all AI and automatic group/test features remain off.
# Stop only the lab worldserver. Run bootstrap-single then activate-single
# with this disabled profile before selecting single-return and starting it.
# Each command verifies the versioned native proof and six live map hashes.
# single-return owns only spawn 900725; home/bounds come from test-points.json.
# hunt-cycle owns the six actors in hunt-population.json (2 bears + 4 deer).
# Stop lab worldserver, set disabled, bootstrap-hunt then activate-hunt before
# selecting hunt-cycle. Hunger evolves naturally; no LLM or groups are enabled.
# hunt-100 owns 100 actors in hunt-population-100.json (20 bears + 80 deer).
# Preserve the original six; stop lab worldserver, set disabled, then run
# bootstrap-hunt-100 and activate-hunt-100 before selecting hunt-100.
LAB_AI_PROFILE=disabled
DEV_UID=1000
DEV_GID=1000

# Optional shared inference backend. All current lab profiles disable requests.
AI_TASK_MODEL_URL=
AI_TASK_MODEL_NAME=
AI_TASK_MODEL_API_KEY=
AI_TASK_MODEL_ENABLE_THINKING=0
AIWORLD_RECORD_HOURS=4
AIWORLD_RECORD_INTERVAL=5
AIWORLD_TEST_MINUTES=60
